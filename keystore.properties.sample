# Archivo de ejemplo para configuración del keystore
# Copia este archivo a keystore.properties y reemplaza con tus valores reales
# IMPORTANTE: keystore.properties está en .gitignore y NO debe subirse al repositorio

KEYSTORE_PASSWORD=tu_password_del_keystore_aqui
KEY_ALIAS=tu_alias_aqui
KEY_PASSWORD=tu_password_de_la_clave_aqui
