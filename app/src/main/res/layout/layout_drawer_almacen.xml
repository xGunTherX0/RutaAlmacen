<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header del Drawer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/espacio_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Almacén"
                android:textColor="@android:color/white"
                android:textSize="@dimen/texto_titulo_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:text="Configura los datos principales de tu almacén."
                android:textColor="@color/colorPrimaryLight"
                android:textSize="@dimen/texto_cuerpo_md" />
        </LinearLayout>

        <!-- Lista de opciones -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/espacio_md"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Nombre del almacén -->
                <LinearLayout
                    android:id="@+id/drawer_nombre_almacen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nombre del almacén"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_media_next"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 2. Horario de atención -->
                <LinearLayout
                    android:id="@+id/drawer_horario_almacen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Horario de atención"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_media_next"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 3. Ubicación del almacén -->
                <LinearLayout
                    android:id="@+id/drawer_ubicacion_almacen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ubicación del almacén"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_media_next"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 4. Categoría del almacén -->
                <LinearLayout
                    android:id="@+id/drawer_categoria_almacen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Categoría del almacén"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_media_next"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 5. Estado del almacén (Switch) -->
                <LinearLayout
                    android:id="@+id/drawer_estado_almacen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cerrar manualmente"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/drawer_switch_estado_almacen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 6. Pagos: Efectivo, Débito -->
                <LinearLayout
                    android:id="@+id/drawer_metodos_pago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:id="@+id/drawer_texto_metodos_pago"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pagos: Efectivo, Débito"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_media_next"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 7. Caja Vecina (Switch) -->
                <LinearLayout
                    android:id="@+id/drawer_caja_vecina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Caja Vecina"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/drawer_switch_caja_vecina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <!-- Cupo disponible (Switch) -->
                <LinearLayout
                    android:id="@+id/drawer_cupo_disponible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cupo disponible"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/drawer_switch_cupo_disponible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 8. Ver Block de Notas -->
                <LinearLayout
                    android:id="@+id/drawer_block_notas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:layout_marginEnd="@dimen/espacio_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notes"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ver Block de Notas"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/espacio_lg"
                    android:background="@color/divisor" />

                <!-- 9. Ver como Comprador -->
                <LinearLayout
                    android:id="@+id/drawer_ver_como_comprador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_lg">

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:layout_marginEnd="@dimen/espacio_md"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ver como Comprador"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                        android:textColor="@color/texto_principal" />

                    <ImageView
                        android:layout_width="@dimen/ancho_icono"
                        android:layout_height="@dimen/ancho_icono"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/texto_terciario" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
