<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedor_comprador"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    tools:context=".ProductosActivity">

    <!-- Header verde con búsqueda -->
    <LinearLayout
        android:id="@+id/header_productos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/espacio_md"
        android:paddingTop="@dimen/espacio_sm"
        android:paddingBottom="@dimen/espacio_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_volver_home"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_boton_alerta_header"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@null"
            app:icon="@drawable/ic_volver"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:rippleColor="#40FFFFFF" />

        <!-- Barra de búsqueda blanca -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contenedor_busqueda_card"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/espacio_sm"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/fila_busqueda"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/espacio_sm">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="#6B7280" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/contenedor_busqueda"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Producto"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_busqueda_producto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textSize="@dimen/texto_cuerpo_md"
                        android:padding="0dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón de filtros/menú -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_info_alertas"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_boton_alerta_header"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@null"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:rippleColor="#40FFFFFF" />
    </LinearLayout>

    <!-- Chips de filtro -->
    <HorizontalScrollView
        android:id="@+id/scroll_filtros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingVertical="@dimen/espacio_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_productos">

        <LinearLayout
            android:id="@+id/contenedor_filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/espacio_md"
            android:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_todos"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/espacio_xs"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/espacio_md"
                android:text="Todos"
                android:textSize="@dimen/texto_cuerpo_sm"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_abierto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/espacio_xs"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/espacio_md"
                android:text="Abierto ahora"
                android:textSize="@dimen/texto_cuerpo_sm"
                app:cornerRadius="18dp"
                app:strokeColor="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_distancia"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/espacio_xs"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/espacio_md"
                android:text="Distancia"
                android:textSize="@dimen/texto_cuerpo_sm"
                app:cornerRadius="18dp"
                app:strokeColor="@color/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_ofertas"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/espacio_xs"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/espacio_md"
                android:text="En oferta"
                android:textSize="@dimen/texto_cuerpo_sm"
                app:cornerRadius="18dp"
                app:strokeColor="@color/colorPrimary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Barra de resultados -->
    <LinearLayout
        android:id="@+id/barra_resultados"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:background="#1F2937"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/espacio_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_filtros">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/texto_contador_resultados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 resultados cerca de ti"
            android:textColor="@android:color/white"
            android:textSize="@dimen/texto_cuerpo_sm" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Contenedor de búsqueda avanzada (oculto por defecto) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contenedor_busqueda_avanzada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espacio_md"
        android:layout_marginTop="@dimen/espacio_sm"
        android:visibility="gone"
        app:cardBackgroundColor="@color/fondo_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barra_resultados">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_sm">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedor_categoria"
                style="@style/Widget.RutaAlmacen.TextInputLayout.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Categoría"
                app:boxBackgroundColor="@color/fondo_card_alt"
                app:endIconMode="dropdown_menu"
                app:hintTextAppearance="@style/TextAppearance.RutaAlmacen.Comprador.BodyMedium">

                <AutoCompleteTextView
                    android:id="@+id/campo_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="@dimen/texto_cuerpo_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_buscar_producto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/espacio_xs"
                android:text="Buscar"
                android:textSize="@dimen/texto_cuerpo_md"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Título Resultados -->
    <TextView
        android:id="@+id/texto_resultados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_sm"
        android:paddingHorizontal="@dimen/espacio_md"
        android:text="Resultados"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_cuerpo_lg"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_busqueda_avanzada" />

    <!-- Lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_resultados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/espacio_md"
        android:paddingTop="@dimen/espacio_xs"
        android:paddingBottom="@dimen/espacio_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_resultados"
        tools:listitem="@layout/item_resultado_producto" />

    <!-- Overlay de carga -->
    <LinearLayout
        android:id="@+id/contenedor_carga_comprador"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fondo_card"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card"
            app:cardUseCompatPadding="true"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="@dimen/espacio_3xl"
                    android:layout_height="@dimen/espacio_3xl"
                    app:indicatorSize="@dimen/espacio_3xl"
                    app:trackThickness="@dimen/espacio_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_sm"
                    android:text="Cargando..."
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Comprador.BodyMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Título oculto para compatibilidad -->
    <TextView
        android:id="@+id/texto_titulo_comprador"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
