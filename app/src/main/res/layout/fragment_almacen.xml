<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/espacio_xxl">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_almacen"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_lg"
                    android:text="Configuración del almacén"
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.TitleMedium"
                    android:textColor="@color/texto_principal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_sm"
                    android:gravity="center"
                    android:text="Gestiona el nombre, horario, ubicación, categoría, estado, pagos y más de tu almacén."
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium"
                    android:textColor="@color/texto_secundario" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_abrir_configuracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xl"
                    android:text="Abrir panel de configuración"
                    android:textColor="@color/colorOnPrimary"
                    app:backgroundTint="@color/boton_principal"
                    app:cornerRadius="@dimen/radio_boton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
