<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VendedorActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedor_vendedor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo_app">

        <LinearLayout
            android:id="@+id/header_vendedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/espacio_md"
            android:paddingTop="@dimen/espacio_sm"
            android:paddingBottom="@dimen/espacio_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/boton_menu_drawer"
                android:layout_width="@dimen/ancho_icono_grande"
                android:layout_height="@dimen/ancho_icono_grande"
                android:layout_marginEnd="@dimen/espacio_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menú de configuración"
                android:src="@drawable/ic_menu_hamburguesa" />

            <TextView
                android:id="@+id/texto_titulo_header_vendedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUTA ALMACÉN"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjeta_verificacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/estado_pendiente"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_vendedor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_verificacion"
                    android:contentDescription="@null"
                    app:tint="@color/colorSecondaryDark" />

                <TextView
                    android:id="@+id/texto_verificacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Tu patente comercial está en proceso de verificación. No podrás publicar productos hasta que sea aprobada."
                    android:textColor="@color/colorSecondaryDark"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/contenedor_fragmentos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/nav_vendedor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tarjeta_verificacion" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav_vendedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/fondo_card"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/colorPrimary"
            app:itemTextAppearanceActive="@style/TextAppearance.RutaAlmacen.Vendedor.Nav"
            app:itemTextAppearanceInactive="@style/TextAppearance.RutaAlmacen.Vendedor.Nav"
            app:itemTextColor="@color/colorPrimary"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/menu_vendedor" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/drawer_almacen"
        layout="@layout/layout_drawer_almacen"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
