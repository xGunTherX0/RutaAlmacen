<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/margen_pantalla">

        <!-- ============================================ -->
        <!-- SECCIÓN SUPERIOR: MÉTODOS INTELIGENTES       -->
        <!-- ============================================ -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agrega productos rápidamente"
            android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.TitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Elige cómo ingresar tus productos"
            android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodySmall" />

        <!-- Card 1: Dictar por voz -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dictar_voz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_lg"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/oferta_card_fondo"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card"
            app:rippleColor="@color/colorPrimaryLight"
            app:strokeColor="@color/oferta_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_lg">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icono_smart_card"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dictar por voz"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyLarge"
                        android:textColor="@color/texto_principal"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Di los productos en voz alta"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodySmall" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ancho_icono"
                    android:layout_height="@dimen/ancho_icono"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/texto_terciario" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Escanear boleta -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_escanear_boleta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_md"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/oferta_card_fondo"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card"
            app:rippleColor="@color/colorPrimaryLight"
            app:strokeColor="@color/oferta_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_lg">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icono_smart_card"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Escanear boleta"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyLarge"
                        android:textColor="@color/texto_principal"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fotografía tu boleta o cuaderno"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodySmall" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ancho_icono"
                    android:layout_height="@dimen/ancho_icono"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/texto_terciario" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Importar Excel -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_importar_excel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_md"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/oferta_card_fondo"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card"
            app:rippleColor="@color/colorPrimaryLight"
            app:strokeColor="@color/oferta_borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_lg">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icono_smart_card"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_document"
                    app:tint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Importar Excel"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyLarge"
                        android:textColor="@color/texto_principal"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carga un archivo CSV o Excel"
                        android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodySmall" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/ancho_icono"
                    android:layout_height="@dimen/ancho_icono"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/texto_terciario" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================ -->
        <!-- SEPARADOR DE FLUJO                           -->
        <!-- ============================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:layout_marginBottom="@dimen/espacio_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/borde_sutil" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/espacio_md"
                android:text="o rellena manualmente"
                android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodySmall"
                android:textColor="@color/texto_terciario" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/borde_sutil" />
        </LinearLayout>

        <!-- ============================================ -->
        <!-- FORMULARIO MANUAL                            -->
        <!-- ============================================ -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contenedor_nuevo_producto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nuevo producto"
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.TitleMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:hint="Nombre del producto"
                    app:hintTextAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_nombre_producto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:text="Categoría"
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium" />

                <Spinner
                    android:id="@+id/spinner_categoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:hint="Precio"
                    app:hintTextAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_precio_producto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:text="Tipo de precio"
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium" />

                <Spinner
                    android:id="@+id/spinner_unidad_precio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:hint="Descripción (opcional)"
                    app:hintTextAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodyMedium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campo_descripcion_producto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:minLines="2"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_guardar_producto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_lg"
                    android:text="Guardar producto"
                    android:textSize="17sp"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón ver planes y contador -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_ver_planes"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_md"
            android:text="Ver planes para más productos" />

        <TextView
            android:id="@+id/texto_limite_productos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/espacio_sm"
            android:textAppearance="@style/TextAppearance.RutaAlmacen.Vendedor.BodySmall" />

    </LinearLayout>
</ScrollView>
