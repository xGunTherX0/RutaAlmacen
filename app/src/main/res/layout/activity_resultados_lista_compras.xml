<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedor_resultados_lista"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    tools:context=".ResultadosListaComprasActivity">

    <!-- Header verde -->
    <LinearLayout
        android:id="@+id/header_resultados_lista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/espacio_md"
        android:paddingTop="@dimen/espacio_sm"
        android:paddingBottom="@dimen/espacio_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_volver_resultados"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_boton_alerta_header"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="@null"
            app:icon="@drawable/ic_volver"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white"
            app:rippleColor="#40FFFFFF" />

        <TextView
            android:id="@+id/texto_titulo_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_sm"
            android:layout_weight="1"
            android:text="Almacenes Ideales"
            android:textColor="@android:color/white"
            android:textSize="@dimen/texto_cuerpo_lg"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido -->
    <LinearLayout
        android:id="@+id/contenedor_contenido_resultados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/espacio_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_resultados_lista">

        <!-- Resumen de la busqueda -->
        <TextView
            android:id="@+id/texto_resumen_busqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_lg"
            android:gravity="center"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_titulo_md"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/texto_subtitulo_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:gravity="center"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_cuerpo_sm" />

        <!-- Lista de resultados -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_resultados_lista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/espacio_md"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/espacio_lg" />

        <!-- Sin resultados -->
        <LinearLayout
            android:id="@+id/contenedor_sin_resultados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.3"
                android:src="@drawable/ic_search"
                app:tint="@color/texto_terciario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:gravity="center"
                android:text="No se encontraron almacenes\ncon esos productos"
                android:textColor="@color/texto_terciario"
                android:textSize="@dimen/texto_cuerpo_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:text="Intenta con otros productos o amplía tu zona"
                android:textColor="@color/texto_terciario"
                android:textSize="@dimen/texto_cuerpo_sm" />
        </LinearLayout>

        <!-- Boton volver a la lista -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/boton_volver_lista"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_boton"
            android:layout_marginTop="@dimen/espacio_md"
            android:text="Volver a mi lista"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/texto_cuerpo_lg"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="@dimen/radio_boton"
            app:elevation="@dimen/elevacion_boton" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
