<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_inicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Fecha y Saludo Superior -->
        <TextView
            android:id="@+id/texto_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunes, 28 julio"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/imagen_perfil">

                <TextView
                    android:id="@+id/texto_saludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Hola,"
                    android:textColor="#0F172A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/texto_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuario"
                    android:textColor="#0F172A"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Avatar circular con foto de perfil -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imagen_perfil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_RutaAlmacen_Circle"
                tools:src="@android:drawable/sym_def_app_icon" />

            <!-- Icono de notificaciones -->
            <ImageView
                android:id="@+id/icono_notificaciones"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toStartOf="@id/imagen_perfil"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:contentDescription="Notificaciones"
                android:padding="8dp"
                android:src="@drawable/ic_notifications_none"
                app:tint="#6B7280" />
        </RelativeLayout>

        <!-- Tarjeta Estado Almacén (Plan) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjeta_estado_almacen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#E6F4EA">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/lbl_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLAN ACTUAL"
                    android:textColor="#137333"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/texto_titulo_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado de tu Almacén"
                    android:textColor="#137333"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/texto_nombre_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lbl_plan"
                    android:layout_marginTop="6dp"
                    android:text="Plan: Cargando..."
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texto_productos_activos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/texto_nombre_plan"
                    android:layout_marginTop="4dp"
                    android:text="0 / 20 productos"
                    android:textColor="#4B5563"
                    android:textSize="13sp"/>

                <ImageView
                    android:id="@+id/icono_plan"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#137333"/>

                <!-- Barra de progreso -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barra_progreso_productos"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_below="@id/texto_productos_activos"
                    android:layout_marginTop="16dp"
                    android:progress="0"
                    app:trackColor="#CEEAD6"
                    app:indicatorColor="#137333"
                    app:trackCornerRadius="2dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/barra_progreso_productos"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/texto_porcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#6B7280"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/texto_actualizar_plan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Actualizar plan →"
                        android:textColor="#137333"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fila de Acciones Rápidas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCIONES RÁPIDAS"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="28dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <!-- Tarjeta Nueva Venta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_nueva_venta"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#E6F7F0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_add"
                        app:tint="#00B589" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Nueva\nVenta"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta Bloc de Notas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_bloc_notas"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFEF3C7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#FFB8860B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Bloc de\nNotas"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Tarjeta de Anuncio AdMob (al final) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjeta_anuncio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="visible"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#F3F4F6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Recomendado para ti"
                    android:textColor="#4B5563"
                    android:textSize="10sp"
                    android:textStyle="italic" />

                <com.google.android.gms.ads.AdView
                    android:id="@+id/ad_view_inicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:adSize="MEDIUM_RECTANGLE"
                    app:adUnitId="ca-app-pub-3940256099942544/6300978111" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Espacio para el menú inferior -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
