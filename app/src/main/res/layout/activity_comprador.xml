<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedor_comprador"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    tools:context=".CompradorActivity">

    <FrameLayout
        android:id="@+id/header_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:elevation="8dp"
        android:fitsSystemWindows="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-30dp"
            android:background="@drawable/bg_header_circulo" />

        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="-24dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_header_circulo" />

        <View
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="72dp"
            android:background="@drawable/bg_header_circulo"
            android:alpha="0.7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_xl"
            android:paddingBottom="@dimen/espacio_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="RUTA ALMACÉN"
                android:textAllCaps="true"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="¿Qué buscas hoy?"
                android:textColor="@android:color/white"
                android:textSize="@dimen/texto_titulo_lg"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chip_ubicacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_ubicacion"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/espacio_md"
                    android:paddingVertical="@dimen/espacio_sm">

                    <ImageView
                        android:id="@+id/icono_ubicacion"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Ubicación"
                        android:src="@drawable/ic_ubicacion"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/texto_ubicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_sm"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Detectando tu zona..."
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/texto_cuerpo_md"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_volver_vendedor"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/espacio_sm"
                    android:background="@drawable/bg_boton_alerta_header"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:backgroundTint="@null"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@android:color/white"
                    app:rippleColor="#40FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_info_alertas"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/espacio_sm"
                    android:background="@drawable/bg_boton_alerta_header"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="!"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:rippleColor="#40FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_contenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_home">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_md"
            android:paddingBottom="@dimen/espacio_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_almacenes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_sm"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fondo_card"
                    app:cardCornerRadius="@dimen/radio_card"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="88dp"
                            android:contentDescription="Almacenes cercanos"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_acceso_almacenes" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/fondo_card"
                            android:gravity="center"
                            android:minHeight="40dp"
                            android:paddingHorizontal="@dimen/espacio_sm"
                            android:paddingTop="@dimen/espacio_sm"
                            android:paddingBottom="@dimen/espacio_sm"
                            android:text="Almacenes cercanos"
                            android:textColor="@color/texto_principal"
                            android:textSize="@dimen/texto_cuerpo_md"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_productos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_sm"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fondo_card"
                    app:cardCornerRadius="@dimen/radio_card"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="230dp"
                            android:layout_height="88dp"
                            android:contentDescription="Buscar productos"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_acceso_productos"
                            android:translationX="-36dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/fondo_card"
                            android:gravity="center"
                            android:minHeight="40dp"
                            android:paddingHorizontal="@dimen/espacio_sm"
                            android:paddingTop="@dimen/espacio_sm"
                            android:paddingBottom="@dimen/espacio_sm"
                            android:text="Buscar productos"
                            android:textColor="@color/texto_principal"
                            android:textSize="@dimen/texto_cuerpo_md"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xl"
                android:text="Categorías"
                android:textColor="@color/texto_principal"
                android:textSize="@dimen/texto_titulo_md"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_categorias_fila1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never" />

                <ImageView
                    android:id="@+id/flecha_cat_fila1_izq"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_flecha_categoria"
                    android:contentDescription="Anterior"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/flecha_cat_fila1_der"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_flecha_categoria"
                    android:contentDescription="Siguiente"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@android:color/white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_categorias_fila2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never" />

                <ImageView
                    android:id="@+id/flecha_cat_fila2_izq"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_flecha_categoria"
                    android:contentDescription="Anterior"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/flecha_cat_fila2_der"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_flecha_categoria"
                    android:contentDescription="Siguiente"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@android:color/white" />
            </FrameLayout>

            <com.google.android.gms.ads.AdView
                android:id="@+id/ad_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_lg"
                app:adSize="BANNER"
                app:adUnitId="ca-app-pub-3940256099942544/6300978111" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/contenedor_carga_comprador"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fondo_card"
            app:cardCornerRadius="@dimen/radio_card"
            app:cardElevation="@dimen/elevacion_card"
            app:cardUseCompatPadding="true"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="@dimen/espacio_3xl"
                    android:layout_height="@dimen/espacio_3xl"
                    app:indicatorSize="@dimen/espacio_3xl"
                    app:trackThickness="@dimen/espacio_xs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_sm"
                    android:text="Cargando..."
                    android:textAppearance="@style/TextAppearance.RutaAlmacen.Comprador.BodyMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
