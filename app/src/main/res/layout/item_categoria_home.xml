<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_xs"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/fondo_card"
    app:cardCornerRadius="@dimen/radio_card"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/espacio_sm">

        <ImageView
            android:id="@+id/icono_categoria"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:contentDescription="Categoría"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/texto_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="@dimen/espacio_xs"
            android:paddingEnd="@dimen/espacio_xs"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_cuerpo_sm"
            android:textStyle="bold" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
